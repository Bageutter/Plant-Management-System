#!/usr/bin/env python3
"""Run the repository AI development reviewer."""

from pathlib import Path
import os
import sys


REPO = Path(__file__).resolve().parent
PIPELINE = REPO / "tools" / "ai-dev" / "pipeline.py"
FEATURES = {
    "1": ("frontend", "Frontend"),
    "2": ("vgarden", "Virtual Garden"),
    "3": ("almanac", "Plant Almanac"),
    "4": ("health", "Plant Health"),
    "5": ("architecture", "Whole project architecture"),
}


def choose_feature() -> str:
    print("\nChoose a feature to review:\n")
    for number, (_, label) in FEATURES.items():
        print(f"  {number}. {label}")
    while True:
        try:
            answer = input("\nEnter 1, 2, 3, 4, or 5: ").strip()
        except (EOFError, KeyboardInterrupt):
            print("\nNo feature selected.")
            raise SystemExit(1)
        if answer in FEATURES:
            scope, _ = FEATURES[answer]
            return scope
        print("Please enter 1, 2, 3, 4, or 5.")


user_args = sys.argv[1:]
if "--scope" not in user_args and not any(arg in {"-h", "--help"} for arg in user_args):
    user_args += ["--scope", choose_feature()]

os.chdir(REPO)
os.execv(sys.executable, [sys.executable, str(PIPELINE)] + user_args)
