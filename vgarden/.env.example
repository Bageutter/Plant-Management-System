# Leave DATABASE_URL unset to use the default local SQLite file (vgarden/instance/vgarden.db).
# Flask-SQLAlchemy resolves relative sqlite:/// paths against the instance folder, so if you
# do set this for SQLite, use an absolute path with four slashes, e.g.:
#   DATABASE_URL=sqlite:////absolute/path/to/vgarden.db
# For Postgres:
#   DATABASE_URL=postgresql://user:password@localhost:5432/vgarden

# Browser-facing base URL of the auth service, used for the shared nav header and to send
# a user there to log in when they hit vgarden with no session.
AUTH_PUBLIC_URL=http://localhost:5001

# Signs vgarden's own session cookie. Distinct from INTER_SERVICE_SECRET below.
SECRET_KEY=dev-secret-key-change-me

# Must match auth's INTER_SERVICE_SECRET exactly - it verifies the SSO handoff token from
# auth and authenticates auth's server-to-server calls to the /gardens API.
INTER_SERVICE_SECRET=dev-inter-service-secret-change-me

# Locally hosted Ollama for the "ask about this garden" AI assistant.
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:4b-instruct
