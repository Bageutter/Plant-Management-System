# Leave DATABASE_URL unset to use the default local SQLite file (health/instance/health.db).
# Flask-SQLAlchemy resolves relative sqlite:/// paths against the instance folder, so if you
# do set this for SQLite, use an absolute path with four slashes, e.g.:
#   DATABASE_URL=sqlite:////absolute/path/to/health.db
# For Postgres:
#   DATABASE_URL=******localhost:5432/health

# Browser-facing base URL of the auth service, used for the "My Gardens" link.
AUTH_PUBLIC_URL=http://localhost:5001

# Locally hosted AI (Ollama). Use http://ollama:11434 when running under docker compose.
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=gemma3:4b
OLLAMA_TIMEOUT=180
OLLAMA_AUTO_PULL=true
OLLAMA_PULL_TIMEOUT=1800

# Maximum accepted image upload size, in bytes.
MAX_UPLOAD_BYTES=12582912
