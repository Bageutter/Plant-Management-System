SECRET_KEY=change-me
# Leave DATABASE_URL unset to use the default local SQLite file (auth/instance/auth.db).
# Flask-SQLAlchemy resolves relative sqlite:/// paths against the instance folder, so if you
# do set this for SQLite, use an absolute path with four slashes, e.g.:
#   DATABASE_URL=sqlite:////absolute/path/to/auth.db
# For Postgres:
#   DATABASE_URL=postgresql://user:password@localhost:5432/auth
SESSION_COOKIE_SECURE=false
# Base URL of the Virtual Garden service (used server-side to create/list/delete gardens).
VGARDEN_URL=http://localhost:5002
# Browser-facing base URL of the Virtual Garden service, used in links rendered to the user.
VGARDEN_PUBLIC_URL=http://localhost:5002
# Browser-facing base URL of the Plant Health Monitoring service, used in links rendered to the user.
HEALTH_PUBLIC_URL=http://localhost:5003
