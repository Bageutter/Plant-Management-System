# Routing table for the single public entry point (http://localhost:3000 locally,
# the proxy container app's HTTPS address on Azure). Every service is path-routed
# from here; nothing else is reachable from outside.
#
# Rendered at container start by the nginx image's envsubst step. Only the ${...}
# variables are substituted (NGINX_ENVSUBST_FILTER in the Dockerfile); nginx's own
# $host / $scheme / $remote_addr variables are left alone.
#
#   local compose : the defaults baked into the image (frontend:5000, Host $host, ...)
#   Azure         : *_UPSTREAM is a service's internal Container Apps FQDN and
#                   *_HOST is that same name, because that ingress routes by Host.
#                   The original public host travels on in X-Forwarded-Host, which
#                   every Flask app honours through ProxyFix(x_host=1).

# Scheme the client actually used. Behind a TLS-terminating edge (Azure Container
# Apps ingress) it arrives in X-Forwarded-Proto; when this proxy is the edge
# (compose on :3000) fall back to our own.
map $http_x_forwarded_proto $client_scheme {
    default $scheme;
    https   https;
    http    http;
}

# --- Endpoint security (bonus B5; also on locally) -------------------------------
# No nginx version in responses or error pages.
server_tokens off;

# The client's own address. Behind the Container Apps edge every request comes from
# the edge, which appends the real client to X-Forwarded-For; the LAST entry is the
# one the edge added (earlier entries are whatever the client sent, so not trusted).
map $http_x_forwarded_for $client_ip {
    "~(?<last>[^,\s]+)\s*$" $last;
    default $remote_addr;
}

# Rate limits per client: a general ceiling for every route, and a much lower one
# for sign-in and registration (password guessing, account spam).
limit_req_zone $client_ip zone=per_client:10m rate=20r/s;
limit_req_zone $client_ip zone=sign_in:10m rate=10r/m;
limit_req_status 429;

# HSTS only when the client actually used HTTPS (never on http://localhost:3000).
map $client_scheme $hsts {
    https "max-age=31536000; includeSubDomains";
    default "";
}

# Ollama-backed AI endpoints (almanac, health, vgarden) can take a while on CPU.
# Keep the proxy from timing out before the app's own client does.
proxy_read_timeout 300s;
proxy_send_timeout 300s;

resolver ${PROXY_DNS_RESOLVER} valid=10s ipv6=off;

# Speak HTTP/1.1 to the services. nginx proxies with HTTP/1.0 by default, which the
# Azure Container Apps ingress in front of each internal app refuses with
# "426 Upgrade Required" (docker compose accepts either, so it only showed in the cloud).
proxy_http_version 1.1;

upstream frontend {
    zone frontend 64k;
    server ${FRONTEND_UPSTREAM} resolve;
}

upstream auth {
    zone auth 64k;
    server ${AUTH_UPSTREAM} resolve;
}

upstream vgarden {
    zone vgarden 64k;
    server ${VGARDEN_UPSTREAM} resolve;
}

upstream health {
    zone health 64k;
    server ${HEALTH_UPSTREAM} resolve;
}

upstream almanac {
    zone almanac 64k;
    server ${ALMANAC_UPSTREAM} resolve;
}

server {
    listen 80;

    limit_req zone=per_client burst=80 nodelay;

    # Security headers on every response (also errors). The pages load HTMX, Alpine,
    # Franken UI and fonts from these CDNs; Alpine evaluates its attribute
    # expressions, hence 'unsafe-eval'. Framing, plugins and foreign form targets are refused.
    add_header Strict-Transport-Security $hsts always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "geolocation=(), microphone=(), payment=(), usb=()" always;
    add_header Cross-Origin-Opener-Policy "same-origin" always;
    add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://unpkg.com https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline' https://unpkg.com https://cdn.jsdelivr.net https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com https://unpkg.com https://cdn.jsdelivr.net; img-src 'self' data: blob: https:; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'" always;
    # The apps' own server banners (gunicorn / Werkzeug) are not passed on.
    proxy_hide_header Server;
    proxy_hide_header X-Powered-By;

    # Dotfiles (.env, .git, ...) are never served or routed on.
    location ~ /\.(?!well-known/) {
        return 404;
    }

    # Answered by the proxy itself (used as its container probe); never routed on.
    location = /proxy-healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    # Frontend (served at the root)
    location / {
        proxy_pass http://frontend;
        proxy_set_header Host ${FRONTEND_HOST};
        proxy_set_header X-Forwarded-Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $client_scheme;
    }

    # Auth
    location /auth/ {
        proxy_pass http://auth/;
        proxy_set_header Host ${AUTH_HOST};
        proxy_set_header X-Forwarded-Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $client_scheme;
        # Tells the Flask app (via ProxyFix) that it is mounted under /auth,
        # so url_for()/redirects come back with the /auth prefix.
        proxy_set_header X-Forwarded-Prefix /auth;
    }

    # Sign-in and registration: the same auth upstream with the stricter limit.
    location ~ ^/auth/(login|register)$ {
        limit_req zone=sign_in burst=10 nodelay;
        proxy_pass http://auth;
        rewrite ^/auth/(.*)$ /$1 break;
        proxy_set_header Host ${AUTH_HOST};
        proxy_set_header X-Forwarded-Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $client_scheme;
        proxy_set_header X-Forwarded-Prefix /auth;
    }

    # Virtual Garden
    location /vgarden/ {
        proxy_pass http://vgarden/;
        proxy_set_header Host ${VGARDEN_HOST};
        proxy_set_header X-Forwarded-Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $client_scheme;
        proxy_set_header X-Forwarded-Prefix /vgarden;
    }

    # Plant Health
    location /health/ {
        # The health service accepts photo uploads up to MAX_UPLOAD_BYTES (12 MiB
        # by default). nginx's own default is 1m, which rejected larger photos
        # with a bare 413 before the app could answer. Allow the app's limit plus
        # multipart overhead, so the app sends its own explanatory 413.
        client_max_body_size 13m;
        proxy_pass http://health/;
        proxy_set_header Host ${HEALTH_HOST};
        proxy_set_header X-Forwarded-Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $client_scheme;
        proxy_set_header X-Forwarded-Prefix /health;
        # The assessment endpoint streams progress events; don't buffer them.
        proxy_buffering off;
    }

    # Almanac
    location /almanac/ {
        # Its validated answer can make several sequential model calls.
        proxy_read_timeout 600s;
        proxy_send_timeout 600s;
        # Allow the Almanac's 5 MB plant-image uploads plus multipart overhead.
        client_max_body_size 6m;
        proxy_pass http://almanac/;
        proxy_set_header Host ${ALMANAC_HOST};
        proxy_set_header X-Forwarded-Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $client_scheme;
        proxy_set_header X-Forwarded-Prefix /almanac;
    }
}
